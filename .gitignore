__pycache__/
*.py[cod]
*.db
.env
.venv/
venv/
*.egg-info/
dist/
build/
.vercel/
.idea/
allure-results/
allure-report/
test-results/
.coverage
coverage.json
coverage.xml
htmlcov/

# Terraform (terraform/) — local provider cache/plugins and any real
# tfvars/plan output; .terraform.lock.hcl IS committed (pins provider versions).
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.auto.tfvars
terraform.tfvars

# Claude Code guidance files — kept locally, not pushed to PRs/main.
# Exceptions: .claude/skills/**/*.md — shared skill files (e.g. steward/
# SKILL.md) that a CI-triggered Claude Code session needs to read; and
# .claude/agents/**/*.md — the Playwright test-planner/generator/healer
# agent definitions (e2e/README.md#playwright-agents), shared so any
# contributor's Claude Code session gets the same agents. Both are
# committed on purpose.
/*CLAUDE*.md
.claude/**/*.md
!.claude/skills/**/*.md
!.claude/agents/**/*.md
