{
  "name": "testflow-e2e",
  "version": "1.0.0",
  "description": "Playwright TypeScript e2e tests for TestFlow",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:mocked": "playwright test --config=playwright.mocked.config.ts",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "allure:generate:mocked": "allure generate allure-results-mocked --clean -o allure-report-mocked",
    "allure:open:mocked": "allure open allure-report-mocked",
    "allure:report:mocked": "npm run allure:generate:mocked && npm run allure:open:mocked"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.79",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.0",
    "fast-check": "^4.9.0",
    "typescript": "^5.0.0"
  }
}
